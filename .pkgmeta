package-as: LegacyAchievementsReforged
manual-changelog:
  filename: LegacyAchievementsReforged/CHANGELOG.md
  markup-type: markdown
enable-nolib-creation: no
plain-copy:
  - LegacyAchievementsReforged/Libs
ignore:
  - .pkgmeta
  - .github
  - .gitattributes
  - .gitignore
  - .release
  - README.md
  - References
  - docs
  - tests
  - tools
  - requirements-dev.txt
move-folders:
  LegacyAchievementsReforged/LegacyAchievementsReforged: LegacyAchievementsReforged
